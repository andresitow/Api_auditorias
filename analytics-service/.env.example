# Debe apuntar a la MISMA base de datos que usa backend/.env (DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infraestructura

# Debe ser el MISMO valor que backend/.env (JWT_SECRET): este servicio valida
# los tokens que emite el login del backend NestJS, no tiene login propio.
JWT_SECRET=<mismo secreto que backend/.env>

PORT=4100

# Orígenes permitidos para CORS y para el WebSocket de progreso (separados por coma).
CORS_ORIGINS=http://localhost:3000
